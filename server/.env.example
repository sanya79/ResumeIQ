PORT=5000
MONGO_URI=mongodb://localhost:27017/resumeiq
JWT_SECRET=your_super_secure_jwt_access_secret_key_change_in_prod
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_super_secure_jwt_refresh_secret_key_change_in_prod
JWT_REFRESH_EXPIRES_IN=7d
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=dummy_smtp_username
SMTP_PASS=dummy_smtp_password
FROM_EMAIL=noreply@resumeiq.com
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
EMAIL_VERIFICATION_REQUIRED=true
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:5000/api/v1/auth/github/callback